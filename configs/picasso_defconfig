# picasso first-console kernel configuration.
#
# Reaches the XNU video/serial console and reports the genuine missing-driver panic.
# Minimal native drivers; UFS / AES / VirtIO / display / Adreno are brought up in
# later stages once the platform boots.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""

# CONFIG_XNU_SOURCE_PTHREAD is not set
# CONFIG_XNU_SOURCE_MOCKFS is not set
CONFIG_XNU_NATIVE_UFS=y
# CONFIG_XNU_NATIVE_AES is not set
# CONFIG_XNU_NATIVE_VIRTIO_CONSOLE is not set
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set
# CONFIG_XNU_NATIVE_MOBILE_DISPLAY is not set
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_ARMVIRT_PLATFORM is not set
# CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE is not set
# The owner-root stack is NOT usable on this board, and the reason is not the virtio gate.
#
# sheng enables VERIFIED_ROOT_PROBE, OWNER_ROOT_AUDIT, OWNER_ROOT_TRUST, OWNER_CACHE_MOUNT,
# OWNER_CACHE_STARTUP and OWNER_UNION_SYSTEMOS. The piece that would help here is the union mount of
# the SystemOS cryptex, which is where the dyld shared cache lives.
#
# Enabling it stops the build at XNU_VERIFIED_ROOT_ARCHIVE: scripts/build-verified-root-probe.py
# refuses with "The two-volume bundle requires the positive original OS policy". That policy is
# Apple-signed material tied to a real device and OS, the same class of input as the root hash --
# unobtainable for a Xiaomi board. The virtio archive the gate also wants was solvable and is now
# built by build-arm-driver.py, but it is not the obstacle.
#
# Reverted to the configuration that builds and boots through launchd. The remaining route is the
# one ios-sweet took: an HFS+ root with the dyld cache linked in, which needs no cryptex and no
# policy at all.
# CONFIG_XNU_VERIFIED_ROOT_PROBE is not set
# CONFIG_XNU_OWNER_ROOT_AUDIT is not set
# CONFIG_XNU_OWNER_ROOT_TRUST is not set
# CONFIG_XNU_OWNER_CACHE_MOUNT is not set
# CONFIG_XNU_OWNER_CACHE_STARTUP is not set
# CONFIG_XNU_OWNER_BOOT_MANIFEST is not set
# CONFIG_XNU_OWNER_DATA_MOUNT is not set
# CONFIG_XNU_OWNER_UNION_SYSTEMOS is not set
# CONFIG_XNU_BOOT_PROGRESS is not set

CONFIG_XNU_OWNER_DATA_VOLUME_UUID="00000000-0000-0000-0000-000000000000"
