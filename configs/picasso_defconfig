# picasso first-console kernel configuration.
#
# Reaches the XNU video/serial console and reports the genuine missing-driver panic.
# Minimal native drivers; UFS / AES / VirtIO / display / Adreno are brought up in
# later stages once the platform boots.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""

# CONFIG_XNU_SOURCE_PTHREAD is not set
# CONFIG_XNU_SOURCE_MOCKFS is not set
CONFIG_XNU_NATIVE_UFS=y
# CONFIG_XNU_NATIVE_AES is not set
# CONFIG_XNU_NATIVE_VIRTIO_CONSOLE is not set
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set
# CONFIG_XNU_NATIVE_MOBILE_DISPLAY is not set
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_ARMVIRT_PLATFORM is not set
# CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE is not set
# The owner-root stack, configured the way sheng configures it.
#
# An earlier attempt gave up on this because build-xnu-4k-baseline.sh requires
# XNU_NATIVE_VIRTIO_BLOCK for XNU_OWNER_ROOT_TRUST, and this board has no virtio block device. That
# reading was wrong: the requirement is a build-time configuration check, and sheng enables the
# virtio block driver for exactly this purpose while booting from UFS with native-ufs-root=1. The
# driver compiles and never matches on hardware that has no virtio.
#
# What the stack buys, per docs/concepts/security.md: the root binding audit, the boot manifest
# hash, the code signing cache carrier, and -- the one that matters here -- a union mount of the
# SystemOS cryptex. The dyld shared cache lives in that cryptex, which is why launchd starts,
# prints its ignition arguments and then blocks with no further block I/O.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/virtio-mmio-block-verified-bundle/libVirtioMmioBlock.a"
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
# CONFIG_XNU_OWNER_CACHE_MOUNT is not set
# CONFIG_XNU_OWNER_CACHE_STARTUP is not set
# CONFIG_XNU_OWNER_BOOT_MANIFEST is not set
# CONFIG_XNU_OWNER_DATA_MOUNT is not set
# CONFIG_XNU_OWNER_UNION_SYSTEMOS is not set
# CONFIG_XNU_BOOT_PROGRESS is not set

CONFIG_XNU_OWNER_DATA_VOLUME_UUID="00000000-0000-0000-0000-000000000000"
