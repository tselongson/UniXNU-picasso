# picasso first-console kernel configuration.
#
# Reaches the XNU video/serial console and reports the genuine missing-driver panic.
# Minimal native drivers; UFS / AES / VirtIO / display / Adreno are brought up in
# later stages once the platform boots.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""

# CONFIG_XNU_SOURCE_PTHREAD is not set
# CONFIG_XNU_SOURCE_MOCKFS is not set
CONFIG_XNU_NATIVE_UFS=y
# CONFIG_XNU_NATIVE_AES is not set
# CONFIG_XNU_NATIVE_VIRTIO_CONSOLE is not set
# CONFIG_XNU_NATIVE_MOBILE_DISPLAY is not set
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_ARMVIRT_PLATFORM is not set
# CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE is not set
# The SystemOS cache mount, in the bring-up form uke uses.
#
# The dyld shared cache lives in the SystemOS cryptex, so the boot needs it union-mounted on the root.
# sheng reaches it through the full owner-root stack, but that stack needs libVerifiedRootProbe.a,
# and build-verified-root-probe.py refuses to produce it without "the positive original OS policy" --
# Apple-signed material bound to a real device, which this board cannot have.
#
# uke carries XNU_BRINGUP_OWNER_CACHE for exactly this: the cache mount, the dyld startup selection,
# the scratch Data mount and the union mount, without OWNER_ROOT_TRUST or VERIFIED_ROOT_PROBE. Two
# patches make that possible here -- one adds the switch to build-xnu-4k-baseline.sh, the other
# relaxes the #error in kern_exec.c that guards DATA_MOUNT without BOOT_MANIFEST.
#
# Note what is deliberately absent: no VERIFIED_ROOT_PROBE, no OWNER_ROOT_AUDIT, no OWNER_ROOT_TRUST,
# no OWNER_BOOT_MANIFEST, and no virtio block. uke's configuration has none of them either.
CONFIG_XNU_BRINGUP_OWNER_CACHE=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
# The owner-cache code calls native_ram_block_gpu_addon and the two native_verified_block_* lookups.
# Those live in NativeRamBlock and NativeVirtioBlock, so both archives have to be linked even though
# this board has neither a ram block nor a virtio device at runtime -- uke enables NATIVE_RAM_BLOCK
# for the same reason.
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/native-virtio-block/libNativeVirtioBlock.a"
# CONFIG_XNU_BOOT_PROGRESS is not set

CONFIG_XNU_OWNER_DATA_VOLUME_UUID="00000000-0000-0000-0000-000000000000"
