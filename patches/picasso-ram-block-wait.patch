+// The Data mount runs from bsd_init, before the APFS volume media exists, so one lookup finds nothing
+// and the mount panics with ENOENT. Wait for it. The wait spins rather than sleeps: this runs before
+// the IOKit work loop services timers, and a sleeping wait here never returned.
 static int selectVolumeSeed(const char *uuid, dev_t *device, char *path, size_t size,
     uint64_t *seedBase,uint64_t *seedBytes,uint8_t seedDigest[32])
 {
+  for (unsigned attempt = 0; attempt < 100; ++attempt) {
+    if (selectVolumeSeedOnce(uuid, device, path, size, seedBase, seedBytes, seedDigest)) return 1;
+    for (volatile uint64_t spin = 0; spin < 100000000; ++spin) {
+    }
+  }
+  // Say which UUID was searched for; without this a miss is silent.
+  IOLog ("NativeRamBlock: no volume media for UUID %s after 100 attempts\n", uuid);
+  return 0;
+}
