+// The Data mount runs from bsd_init, before the APFS volume media exists: the screen shows disk5s2
+// being published after the failure. One lookup therefore finds nothing and the mount panics with
+// ENOENT, so wait for the media the way the verified-block path already does.
 static int selectVolumeSeed(const char *uuid, dev_t *device, char *path, size_t size,
     uint64_t *seedBase,uint64_t *seedBytes,uint8_t seedDigest[32])
 {
+  for (unsigned attempt = 0; attempt < 100; ++attempt) {
+    if (selectVolumeSeedOnce(uuid, device, path, size, seedBase, seedBytes, seedDigest)) return 1;
+    // Spin rather than IOSleep: this runs from bsd_init before the IOKit work loop is servicing
+    // timers, and a sleeping wait here hangs about half the time. The whole wait is bounded at ten
+    // seconds, which is acceptable during bring-up.
+    for (volatile uint64_t spin = 0; spin < 100000000; ++spin) {
+    }
+  }
+  // Say which UUID was searched for and how many media answered; without this a miss is silent.
+  IOLog ("NativeRamBlock: no volume media for UUID %s after 100 attempts\\n", uuid);
+  return 0;
+}
