--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -9535,6 +9535,277 @@
     printf("PICASSO_NETWORK config stage=%d error=%d stack_s=5 quiet_s=5\n", stage, error);
 }
 
+/* Update the approved launchd jobs before launchd opens its persistent
+ * overrides. The seed recipe/UUID stays stable. Unknown contents are preserved;
+ * only the exact shipped XML and the exact result are accepted. This does not
+ * provide Bluetooth hardware. Atomic rename leaves old or new policy on disk.
+ */
+static const uint8_t picasso_jobs_before_sha[32] = {0xc5,0x49,0xe5,0x7f,0x02,0x60,0xf4,0x82,0x98,0x95,0x3f,0xa2,0x14,0xff,0x2e,0x73,0x2a,0xe9,0xa3,0xd8,0x4d,0x57,0x5c,0x74,0xea,0x16,0xd6,0xbc,0xb3,0xce,0x4e,0x17};
+static const uint8_t picasso_jobs_after_sha[32] = {0x0e,0x38,0xd7,0x93,0xe7,0xbb,0x68,0xf9,0xc0,0x1e,0xcc,0x0d,0xdf,0xe4,0x6f,0x37,0x51,0x91,0x11,0xa6,0x08,0x59,0xb4,0xb7,0x4b,0xf5,0xca,0x4c,0x15,0x7f,0x12,0x70};
+
+static int
+picasso_jobs_match(const uint8_t *bytes, size_t size, const uint8_t expected[32])
+{
+    uint8_t digest[32]; SHA256_CTX sha;
+    SHA256_Init(&sha); SHA256_Update(&sha, bytes, size); SHA256_Final(digest, &sha);
+    return memcmp(digest, expected, sizeof(digest)) == 0;
+}
+
+static int
+picasso_jobs_metadata(const char *path, int type, vfs_context_t ctx,
+    int follow, int *observed)
+{
+    vnode_t vp = NULLVP;
+    if (observed) *observed = -1;
+    /* /private/var is an APFS firmlink onto the Data volume.  When a
+     * directory is the lookup TERMINAL, NOFOLLOW hands back the firmlink
+     * vnode (VLNK) and vnode_vtype(vp) != VDIR fails with EINVAL.
+     * Intermediate components are always resolved - that is why
+     * picasso_ifnamer_mount() succeeds on /private/var/picasso.
+     * Follow directories, but keep NOFOLLOW for the policy files. */
+    int error = vnode_lookup(path, follow ? 0 : VNODE_LOOKUP_NOFOLLOW,
+        &vp, ctx);
+    if (error) return error;
+    struct vnode_attr va;
+    VATTR_INIT(&va);
+    VATTR_WANTED(&va, va_uid); VATTR_WANTED(&va, va_gid);
+    VATTR_WANTED(&va, va_mode); VATTR_WANTED(&va, va_nlink);
+    int actual = vnode_vtype(vp);
+    if (observed) *observed = actual;
+    if (actual != type) error = EINVAL;
+    if (!error) error = vnode_getattr(vp, &va, ctx);
+    if (!error && (!VATTR_IS_SUPPORTED(&va, va_uid) || !VATTR_IS_SUPPORTED(&va, va_gid) ||
+        !VATTR_IS_SUPPORTED(&va, va_mode) || !VATTR_IS_SUPPORTED(&va, va_nlink) ||
+        va.va_uid || va.va_gid || (va.va_mode & 0022) ||
+        (type == VREG && va.va_nlink != 1))) error = EPERM;
+    vnode_put(vp);
+    return error;
+}
+
+static int
+picasso_jobs_sync(const char *path, vfs_context_t ctx)
+{
+    vnode_t vp = NULLVP;
+    int error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+    if (!error) { error = VNOP_FSYNC(vp, MNT_WAIT, ctx); vnode_put(vp); }
+    return error;
+}
+
+static int
+picasso_jobs_policy_ok(const uint8_t *bytes, size_t size)
+{
+    static const char *const marks[] = {"<?xml", "<plist", "<dict>",
+        "</dict>", "</plist>"};
+    size_t m, i;
+
+    if (size < 64 || size > 8192) return 0;
+    for (m = 0; m < 5; m++) {
+        size_t n = strlen(marks[m]);
+        int found = 0;
+        for (i = 0; i + n <= size; ++i) {
+            if (!memcmp(bytes + i, marks[m], n)) { found = 1; break; }
+        }
+        if (!found) return 0;
+    }
+    return 1;
+}
+
+/* No approved job key may remain after the rewrite. */
+static int
+picasso_jobs_released(const uint8_t *bytes, size_t size)
+{
+    static const char *const keys[] = {
+        "<key>com.apple.bluetoothd</key>",
+        "<key>com.apple.wifid</key>",
+    };
+    size_t k, i;
+
+    for (k = 0; k < 2; ++k) {
+        size_t n = strlen(keys[k]);
+        for (i = 0; i + n <= size; ++i)
+            if (!memcmp(bytes + i, keys[k], n)) return 0;
+    }
+    return 1;
+}
+
+/* Remove ONE approved job entry in place.  Every other byte is preserved.
+ * Returns 0 when the key is absent (already enabled), EINVAL for a value
+ * that is neither <true/> nor <false/> (unknown contents: do not touch). */
+static int
+picasso_jobs_release_key(uint8_t *bytes, uint64_t *size, const char *needle,
+    size_t needle_len, int *removed)
+{
+    static const char true_tag[] = "<true/>";
+    static const char false_tag[] = "<false/>";
+    uint64_t at, start, after, end;
+
+    for (at = 0; at + needle_len <= *size &&
+        memcmp(bytes + at, needle, needle_len); ++at) {}
+    if (at + needle_len > *size) return 0;
+
+    start = at;
+    while (start > 0 && (bytes[start - 1] == '\t' ||
+        bytes[start - 1] == ' ')) start--;
+    after = at + needle_len;
+    while (after < *size && (bytes[after] == ' ' || bytes[after] == '\t' ||
+        bytes[after] == '\r' || bytes[after] == '\n')) after++;
+    if (after + sizeof(true_tag) - 1 > *size) return EINVAL;
+    if (!memcmp(bytes + after, false_tag, sizeof(false_tag) - 1)) {
+        return 0;   /* launchd already enabled this job */
+    }
+    if (memcmp(bytes + after, true_tag, sizeof(true_tag) - 1)) return EINVAL;
+
+    end = after + sizeof(true_tag) - 1;
+    while (end < *size && (bytes[end] == ' ' || bytes[end] == '\t')) end++;
+    if (end < *size && bytes[end] == '\r') end++;
+    if (end < *size && bytes[end] == '\n') end++;
+    memmove(bytes + start, bytes + end, *size - end);
+    *size -= end - start;
+    *removed = 1;
+    return 0;
+}
+static int
+picasso_jobs_enable(proc_t p, user_addr_t scratch)
+{
+    static const char file[] = "/private/var/db/com.apple.xpc.launchd/disabled.plist";
+    static const char temp[] = "/private/var/db/com.apple.xpc.launchd/.picasso-disabled.tmp";
+    static const char *const entries[] = {"\t<key>com.apple.bluetoothd</key>\n\t<true/>\n",
+                                          "\t<key>com.apple.wifid</key>\n\t<true/>\n"};
+    static const size_t entry_lens[] = {
+        sizeof("\t<key>com.apple.bluetoothd</key>\n\t<true/>\n") - 1,
+        sizeof("\t<key>com.apple.wifid</key>\n\t<true/>\n") - 1,
+    };
+    const char *dirs[] = {"/private/var", "/private/var/db", "/private/var/db/com.apple.xpc.launchd"};
+    vfs_context_t ctx = vfs_context_current();
+    int error = 0, changed = 0;
+    int32_t result = 0;
+    uint8_t *bytes = NULL;
+    uint64_t size = 0;
+    /* One-shot branch diagnostics: printed even on early failure. */
+    int diag_m[4] = {0, 0, 0, 0};
+    int diag_vt[4] = {-1, -1, -1, -1};
+    int diag_e[2] = {-1, -1};
+    int diag_rd = 0, diag_before = -1, diag_after = -1;
+    int diag_form = 0, diag_removed = 0, strict = 0;
+    static const char *const keys[] = {
+        "<key>com.apple.bluetoothd</key>",
+        "<key>com.apple.wifid</key>",
+    };
+    static const size_t key_lens[] = {
+        sizeof("<key>com.apple.bluetoothd</key>") - 1,
+        sizeof("<key>com.apple.wifid</key>") - 1,
+    };
+    uint8_t diag_head[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    char diag_text[97] = {0};
+    for (unsigned i = 0; !error && i < 3; ++i) {
+        diag_m[i] = picasso_jobs_metadata(dirs[i], VDIR, ctx, 1, &diag_vt[i]);
+        error = diag_m[i];
+    }
+    if (!error) diag_m[3] = picasso_jobs_metadata(file, VREG, ctx, 0, &diag_vt[3]);
+    if (!error) error = diag_m[3];
+    if (error) goto done;
+    bytes = kalloc_data(8192, Z_WAITOK);
+    if (!bytes) { error = ENOMEM; goto done; }
+    diag_rd = picasso_ifnamer_read(file, bytes, 8192, &size, ctx);
+    if (diag_rd) { error = diag_rd; goto done; }
+    for (unsigned i = 0; i < 8 && i < size; ++i) diag_head[i] = bytes[i];
+    diag_after = picasso_jobs_match(bytes, (size_t)size, picasso_jobs_after_sha);
+    if (diag_after) goto done;   /* already migrated: success, no change */
+    diag_before = picasso_jobs_match(bytes, (size_t)size, picasso_jobs_before_sha);
+    for (unsigned i = 0; i < 96 && i < size; ++i) {
+        uint8_t ch = bytes[i];
+        diag_text[i] = (ch >= 32 && ch < 127) ? (char)ch : '.';
+    }
+    diag_text[(size < 96) ? (size_t)size : 96] = 0;
+    if (diag_before) {
+        /* Pristine seed: byte-exact before -> after, verified by SHA. */
+        diag_form = 1;
+        strict = 1;
+        for (unsigned i = 0; i < 2; ++i) {
+            size_t len = entry_lens[i], at;
+            for (at = 0; at + len <= size && memcmp(bytes + at, entries[i], len); ++at) {}
+            diag_e[i] = (int)at;
+            if (at + len > size) { error = EINVAL; goto done; }
+            memmove(bytes + at, bytes + at + len, (size_t)size - at - len);
+            size -= len;
+        }
+        if (!picasso_jobs_match(bytes, (size_t)size, picasso_jobs_after_sha)) { error = EINVAL; goto done; }
+    } else {
+        /* Persistent Data: launchd rewrote the plist in its own XML form
+         * (CoachZ coachz-prelink-watchdog-replace.patch).  Accept a
+         * well-formed XML plist and remove ONLY the two approved keys;
+         * every other byte stays exactly where it was. */
+        diag_form = 2;
+        if (!picasso_jobs_policy_ok(bytes, (size_t)size)) { error = EINVAL; goto done; }
+        for (unsigned i = 0; i < 2; ++i) {
+            error = picasso_jobs_release_key(bytes, &size,
+                keys[i], key_lens[i], &diag_removed);
+            if (error) goto done;
+        }
+        if (!diag_removed) goto done;   /* both keys absent: already enabled */
+        if (!picasso_jobs_policy_ok(bytes, (size_t)size) ||
+            !picasso_jobs_released(bytes, (size_t)size)) {
+            error = EINVAL; goto done;
+        }
+    }
+    /* A power loss may leave our exclusive temporary file. Never follow links. */
+    error = picasso_jobs_metadata(temp, VREG, ctx, 0, NULL);
+    if (!error) {
+        struct unlink_args args = {.path = scratch};
+        error = copyout(temp, scratch, sizeof(temp));
+        if (!error) error = unlink(p, &args, &result);
+    } else if (error == ENOENT) error = 0;
+    if (error) goto done;
+    vnode_t vp = NULLVP;
+    error = vnode_open(temp, FWRITE | O_CREAT | O_EXCL | O_NOFOLLOW, 0600, 0, &vp, ctx);
+    if (error) goto done;
+    int resid = 0;
+    error = vn_rdwr(UIO_WRITE, vp, (caddr_t)bytes, (int)size, 0, UIO_SYSSPACE,
+        IO_NOAUTH, vfs_context_ucred(ctx), &resid, p);
+    if (!error && resid) error = EIO;
+    if (!error) error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+    int closed = vnode_close(vp, FWRITE, ctx);
+    if (!error) error = closed;
+    if (error) goto done;
+    error = picasso_jobs_metadata(temp, VREG, ctx, 0, NULL);
+    if (error) goto done;
+    uint64_t verify_size = 0;
+    error = picasso_ifnamer_read(temp, bytes, 8192, &verify_size, ctx);
+    if (!error && (verify_size != size ||
+        (strict ? !picasso_jobs_match(bytes, (size_t)verify_size, picasso_jobs_after_sha)
+                : (!picasso_jobs_policy_ok(bytes, (size_t)verify_size) ||
+                   !picasso_jobs_released(bytes, (size_t)verify_size))))) error = EIO;
+    if (error) goto done;
+    struct rename_args args = {.from = scratch, .to = scratch + 0x200};
+    error = copyout(temp, args.from, sizeof(temp));
+    if (!error) error = copyout(file, args.to, sizeof(file));
+    if (!error) error = rename(p, &args, &result);
+    if (!error) { changed = 1; error = picasso_jobs_sync(dirs[2], ctx); }
+    if (!error) {
+        error = picasso_ifnamer_read(file, bytes, 8192, &verify_size, ctx);
+        if (!error && (verify_size != size ||
+        (strict ? !picasso_jobs_match(bytes, (size_t)verify_size, picasso_jobs_after_sha)
+                : (!picasso_jobs_policy_ok(bytes, (size_t)verify_size) ||
+                   !picasso_jobs_released(bytes, (size_t)verify_size))))) error = EIO;
+    }
+done:
+    printf("PICASSO_JOBS diag meta=%d/%d/%d/%d vt=%d/%d/%d/%d rd=%d size=%llu "
+        "head=%02x%02x%02x%02x%02x%02x%02x%02x before=%d after=%d e=%d/%d\n",
+        diag_m[0], diag_m[1], diag_m[2], diag_m[3],
+        diag_vt[0], diag_vt[1], diag_vt[2], diag_vt[3], diag_rd,
+        (unsigned long long)size, (unsigned)diag_head[0],
+        (unsigned)diag_head[1], (unsigned)diag_head[2],
+        (unsigned)diag_head[3], (unsigned)diag_head[4],
+        (unsigned)diag_head[5], (unsigned)diag_head[6],
+        (unsigned)diag_head[7], diag_before, diag_after,
+        diag_e[0], diag_e[1]);
+    printf("PICASSO_JOBS form=%d removed=%d head=%s\n",
+        diag_form, diag_removed, diag_text);
+    if (bytes) kfree_data(bytes, 8192);
+    printf("PICASSO_JOBS jobs enabled=%u changed=%u error=%d\n", !error, changed, error);
+    return error;
+}
+
 /* One read-only library union; signature/MAC/VM checks run normally on load. */
 static void
 picasso_ui_library_mount(proc_t p, user_addr_t scratch)
@@ -9635,6 +9906,7 @@
 	if (!error) native_picasso_apps_mount(p, scratch);
 	if (!error) picasso_ui_library_mount(p, scratch);
 	if (!error) picasso_ifnamer_mount(p, scratch);
+	if (!error) (void)picasso_jobs_enable(p, scratch);
 #endif
 done:
 	if (data_root) vnode_put(data_root);
