#!/usr/bin/env python3
"""Build this board in a patched cache; leave the upstream checkout unchanged."""
import hashlib
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

DEVICE = Path(__file__).resolve().parent
UPSTREAM = 'https://github.com/UniXNU/UniXNU.git'


def prepare(device=DEVICE, source=None):
    revision = (device / 'upstream.rev').read_text().strip()
    if not re.fullmatch('[0-9a-f]{40}', revision):
        raise ValueError('upstream.rev must contain a full Git commit ID')
    patch = device / 'patches/unixnu-source-kernel.patch'
    usb_patch = device / 'patches/picasso-usb-console-xnu.patch'
    rootauth_patch = device / 'patches/picasso-rootauth-xnu.patch'
    bringup_script = device / 'patches/picasso-bringup-owner-cache.patch'
    bringup_kexec = device / 'patches/picasso-bringup-kern-exec.patch'
    sandbox_stub = device / 'patches/picasso-sandbox-stub.patch'
    # Every patch that changes compiled kernel code or the build script participates in the
    # fingerprint, so a tree cached without one is never reused.
    fingerprint = hashlib.sha256(patch.read_bytes() + b'\0' + usb_patch.read_bytes()
                                 + b'\0' + rootauth_patch.read_bytes()
                                 + b'\0' + bringup_script.read_bytes()
                                 + b'\0' + bringup_kexec.read_bytes()
                                 + b'\0' + sandbox_stub.read_bytes()).hexdigest()
    cache = device / '.cache'
    target = cache / f'upstream-{revision[:12]}-{fingerprint[:12]}'
    if target.is_dir():
        return target
    source = source or device.parent / 'UniXNU'
    local = (source / '.git').exists()
    cache.mkdir(parents=True, exist_ok=True)

    def git(*args, cwd=None):
        subprocess.run(['git', *map(str, args)], cwd=cwd, check=True, stdout=sys.stderr)

    with tempfile.TemporaryDirectory(prefix='prepare-', dir=cache) as temporary:
        tree = Path(temporary) / 'tree'
        git('clone', '--no-checkout', '--no-hardlinks', source if local else UPSTREAM, tree)
        found = subprocess.run(['git', 'cat-file', '-e', revision + '^{commit}'], cwd=tree,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if found.returncode:
            git('fetch', UPSTREAM, revision, cwd=tree)
        git('checkout', '--detach', revision, cwd=tree)
        if (tree / '.gitmodules').is_file():
            entries = subprocess.check_output(
                ['git', 'config', '-f', '.gitmodules', '--get-regexp', r'submodule\..*\.path'],
                cwd=tree, text=True)
            for entry in entries.splitlines():
                key, path = entry.split(maxsplit=1)
                if local and (source / path / '.git').exists():
                    git('config', key.removesuffix('.path') + '.url', source / path, cwd=tree)
            git('-c', 'protocol.file.allow=always', 'submodule', 'update', '--init', '--recursive', cwd=tree)
        git('apply', '--check', patch, cwd=tree)
        git('apply', patch, cwd=tree)
        # The embedded copy only has to exist so the tree carries a placeholder; its content is
        # replaced below with the standalone patch. Match on the name rather than the exact prefix:
        # the file is named so that it sorts before the patches that shift bsd_init.c line numbers.
        embedded = sorted((tree / 'patches/xnu').glob('*picasso-usb-console.patch'))
        if not embedded:
            raise FileNotFoundError('the source patch must create patches/xnu/*picasso-usb-console.patch')
        for path in embedded:
            path.write_bytes(usb_patch.read_bytes())
        # Applied by the build as part of patches/xnu/*.patch, in sorted order. zzz keeps it after
        # every patch that moves lines in bsd_init.c.
        (tree / 'patches/xnu/zzz-picasso-rootauth.patch').write_bytes(rootauth_patch.read_bytes())
        # Applied by the build after offline-owner-systemos-mount.patch, whose #error it relaxes.
        (tree / 'patches/xnu/zzzz-picasso-bringup-kern-exec.patch').write_bytes(bringup_kexec.read_bytes())
        # zzzzz so it lands after every other patch; it only touches __mac_syscall.
        (tree / 'patches/xnu/zzzzz-picasso-sandbox-stub.patch').write_bytes(sandbox_stub.read_bytes())
        # The build script itself: patched here rather than through patches/xnu because bash has
        # already parsed the running script by the time those are applied.
        subprocess.run(['git', 'apply', str(bringup_script)], cwd=tree, check=True,
                       stdout=sys.stderr, stderr=sys.stderr)
        tree.rename(target)
    return target


def main():
    tree = prepare()
    if sys.argv[1:] == ['--prepare']:
        print(tree)
        return
    os.environ.setdefault('UNIXNU_DEVICE', str(DEVICE))
    os.environ.setdefault('UNIXNU_OUT', str(DEVICE / 'out'))
    uefi = DEVICE.parent / 'Mu-Silicium'
    if uefi.is_dir():
        output = DEVICE / 'out/picasso/uefi-build'
        if not os.path.lexists(uefi / 'Build'):
            output.mkdir(parents=True, exist_ok=True)
            (uefi / 'Build').symlink_to(os.path.relpath(output, uefi), target_is_directory=True)
        os.environ.setdefault('UNIXNU_UEFI', str(uefi))
        os.environ.setdefault('UNIXNU_EDK2', str(uefi / 'Mu_Basecore'))
    os.execv(sys.executable, [sys.executable, str(tree / 'unixnu'), *sys.argv[1:]])


if __name__ == '__main__':
    main()
