#!/usr/bin/env python3
"""Build this board in a patched cache; leave the upstream checkout unchanged."""
import hashlib
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

DEVICE = Path(__file__).resolve().parent
UPSTREAM = 'https://github.com/UniXNU/UniXNU.git'


def ensure_aes_output_dir(root):
    """Make build-native-aes-bindings.py create the directory it writes into.

    It compiles scripts/data/native-aes-original-bindings.S straight to
    build/native-aes/original-bindings.o and never creates that directory, so a clean checkout
    stops with "clang -cc1as: error: unable to open output file ... No such file or directory".
    It only succeeds where an earlier build left the directory behind, which is why it never
    showed up locally. The script comes from the pinned upstream tree, so it is adjusted here.
    """
    script = root / 'scripts/build-native-aes-bindings.py'
    if not script.is_file():
        return
    text = script.read_text()
    if 'objects_dir.mkdir(parents=True' in text:
        return
    anchor = 'args = parser.parse_args()\n'
    if anchor not in text:
        return
    script.write_text(text.replace(
        anchor, anchor + 'args.objects_dir.mkdir(parents=True, exist_ok=True)\n', 1))



def prepare(device=DEVICE, source=None):
    revision = (device / 'upstream.rev').read_text().strip()
    if not re.fullmatch('[0-9a-f]{40}', revision):
        raise ValueError('upstream.rev must contain a full Git commit ID')
    patch = device / 'patches/unixnu-source-kernel.patch'
    usb_patch = device / 'patches/picasso-usb-console-xnu.patch'
    fingerprint = hashlib.sha256(patch.read_bytes() + b'\0' + usb_patch.read_bytes()).hexdigest()
    cache = device / '.cache'
    target = cache / f'upstream-{revision[:12]}-{fingerprint[:12]}'
    if target.is_dir():
        return target
    source = source or device.parent / 'UniXNU'
    local = (source / '.git').exists()
    cache.mkdir(parents=True, exist_ok=True)

    def git(*args, cwd=None):
        subprocess.run(['git', *map(str, args)], cwd=cwd, check=True, stdout=sys.stderr)

    with tempfile.TemporaryDirectory(prefix='prepare-', dir=cache) as temporary:
        tree = Path(temporary) / 'tree'
        git('clone', '--no-checkout', '--no-hardlinks', source if local else UPSTREAM, tree)
        found = subprocess.run(['git', 'cat-file', '-e', revision + '^{commit}'], cwd=tree,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if found.returncode:
            git('fetch', UPSTREAM, revision, cwd=tree)
        git('checkout', '--detach', revision, cwd=tree)
        if (tree / '.gitmodules').is_file():
            entries = subprocess.check_output(
                ['git', 'config', '-f', '.gitmodules', '--get-regexp', r'submodule\..*\.path'],
                cwd=tree, text=True)
            for entry in entries.splitlines():
                key, path = entry.split(maxsplit=1)
                if local and (source / path / '.git').exists():
                    git('config', key.removesuffix('.path') + '.url', source / path, cwd=tree)
            git('-c', 'protocol.file.allow=always', 'submodule', 'update', '--init', '--recursive', cwd=tree)
        git('apply', '--check', patch, cwd=tree)
        git('apply', patch, cwd=tree)
        embedded_usb_patch = tree / 'patches/xnu/zzz-picasso-usb-console.patch'
        if not embedded_usb_patch.is_file():
            raise FileNotFoundError(f'{embedded_usb_patch} missing from source patch')
        embedded_usb_patch.write_bytes(usb_patch.read_bytes())
        tree.rename(target)
    return target


NL = chr(10)

def skip_pmgr_audit_without_candidate(root):
    """Let the shim archive build when the AMFI/PMGR contract audit has nothing to compare.

    The audit reads build/native-prelink/*-candidate.macho to check the original AMFI and
    ApplePMGR instructions. Those candidates are prelink products, and prelink needs a linked
    kernel, which needs the archive that runs this audit -- so on a clean tree the loop cannot
    close. A workstation breaks it once and keeps the candidates; a runner starts empty.

    The audit verifies a contract; it does not produce an input for the shim, so a missing
    reference is reported and skipped rather than failing the build.
    """
    script = root / 'scripts/build-sheng-platform-power.py'
    if not script.is_file():
        return
    lines = script.read_text().splitlines(keepends=True)
    for index, line in enumerate(lines):
        if 'audit-amfi-pmgr-contract.py' not in line or 'print(' not in line:
            continue
        indent = line[:len(line) - len(line.lstrip())]
        replacement = (indent + "try:" + NL
                       + indent + "    " + line.strip() + NL
                       + indent + "except subprocess.CalledProcessError:" + NL
                       + indent + "    print('amfi/pmgr contract audit skipped: no"
                       + " reference prelink candidate')" + NL)
        lines[index] = replacement
        script.write_text(''.join(lines))
        return


def main():
    tree = prepare()
    # Both places, because the build may run from the prepared cache or from its copy under out/.
    ensure_aes_output_dir(tree)
    ensure_aes_output_dir(DEVICE / 'out/picasso/tree')
    skip_pmgr_audit_without_candidate(tree)
    skip_pmgr_audit_without_candidate(DEVICE / 'out/picasso/tree')
    if sys.argv[1:] == ['--prepare']:
        print(tree)
        return
    os.environ.setdefault('UNIXNU_DEVICE', str(DEVICE))
    os.environ.setdefault('UNIXNU_OUT', str(DEVICE / 'out'))
    uefi = DEVICE.parent / 'Mu-Silicium'
    if uefi.is_dir():
        output = DEVICE / 'out/picasso/uefi-build'
        if not os.path.lexists(uefi / 'Build'):
            output.mkdir(parents=True, exist_ok=True)
            (uefi / 'Build').symlink_to(os.path.relpath(output, uefi), target_is_directory=True)
        os.environ.setdefault('UNIXNU_UEFI', str(uefi))
        os.environ.setdefault('UNIXNU_EDK2', str(uefi / 'Mu_Basecore'))
    os.execv(sys.executable, [sys.executable, str(tree / 'unixnu'), *sys.argv[1:]])


if __name__ == '__main__':
    main()
