# The verified-root policy tree is a build input whose bytes are hashed: the
# SHA-256 of policy.S is recorded in attestation.json, and build-arm-driver.py
# refuses the tree when the two disagree. Any CRLF conversion on checkout would
# change that hash, so pin the newline for this directory. The .bin blobs are
# binary and never converted.
policy/verified-root-picasso/** text eol=lf
policy/verified-root-picasso/**/*.bin binary
policy/verified-root-picasso/*.bin binary

# Published handoff documents and daily logs are generated from the local
# workspace by work/publish-wifi-handoff.py, which writes LF.  Pin the newline
# so a Windows checkout does not turn every re-publish into a whole-tree diff.
docs/wifi-handoff/** text eol=lf
